# =============================================================================
# HOMELAB - ENVIRONMENT  (template)
#
# Mostly consumed by `docker compose`, through ${VAR} interpolation in
# compose.infra.yml / compose.apps.yml / compose.media.yml /
# compose.download.yml / compose.ai.yml. There is no `env_file:` anywhere in
# the stack, so a variable that no compose file names is delivered to no
# container -- adding one here on its own does nothing.
#
# The exception is the HOST-SIDE TOOLING block at the end, which compose
# never reads; those are for the scripts in this repo and for setup by hand.
#
# Copy to .env and fill in. This template IS committed; .env never is.
# Confirm with:  git check-ignore -v .env
# `docker compose config` resolves every value below into plaintext; if you
# redirect its output anywhere, keep that somewhere gitignored and 700/600
# (this stack uses ./.compose-check/ by convention).
#
# Quoting: compose interpolates unquoted values, so a value containing a
# literal `$` must be single-quoted or everything from the `$` on is read as
# a variable name and the value silently truncates. Generated secrets are the
# usual casualty -- `openssl rand -base64` output can contain one.
#
# Each entry names the service that reads it. Kept in that order rather than
# by topic, so "what breaks if I change this" is answerable at a glance.
# =============================================================================


# ----------------------------------------------------------------------------
# GLOBAL
# ----------------------------------------------------------------------------

# Every container in the stack that takes one (36 of 41 services).
TZ=Etc/UTC
PUID=1000

# The LinuxServer images -- bazarr, bazarr4k, jellyfin, prowlarr,
# qbittorrent, radarr, radarr4k, sabnzbd, sonarr, sonarr4k, tdarr -- plus
# gitea. Must match the owner of the bind-mounted paths, or the *arr
# apps will fail to write to /mnt/media.
PGID=1000

# ----------------------------------------------------------------------------
# VPN  (pia-wireguard)
#
# Every download client runs in this container's network namespace via
# network_mode: "service:pia-wireguard". If it fails to come up they have
# no network at all, rather than leaking traffic.
# ----------------------------------------------------------------------------
PIA_USERNAME=pNNNNNNN
PIA_PASSWORD=change-me

# PIA region id, not a country name. Any region works; list them with the
# PIA app and swap in your own.
PIA_LOCATION=swiss

# ----------------------------------------------------------------------------
# INDEXING  (bitmagnet)
# ----------------------------------------------------------------------------

# Shared by bitmagnet and bitmagnet-db; changing it
# here alone will not change the password already stored in the volume.
BITMAGNET_DB_PASSWORD=generate-a-long-random-string

# bitmagnet metadata lookups.
TMDB_API_KEY=your-tmdb-api-key

# ----------------------------------------------------------------------------
# GITEA  (git.example.com)
# ----------------------------------------------------------------------------
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea

# gitea + gitea-db.
GITEA_DB_PASSWORD=generate-a-long-random-string

# gitea. Also hardcoded as GITEA__server__DOMAIN and SSH_DOMAIN in
# compose.apps.yml -- change all three together. Git over SSH is on port 2222.
GITEA_ROOT_URL=https://git.example.com/

# ----------------------------------------------------------------------------
# CALAGOPUS  (panel.example.com)  -- game server panel
# ----------------------------------------------------------------------------
CALAGOPUS_DB_NAME=panel
CALAGOPUS_DB_USER=panel

# calagopus + calagopus-db.
CALAGOPUS_DB_PASSWORD=generate-a-long-random-string

# calagopus. Encrypts node tokens and other secrets in the database. The panel
# will not start without it. Rotating it later requires re-encrypting
# everything already stored, so set it once and leave it alone.
#   openssl rand -hex 16
CALAGOPUS_ENCRYPTION_KEY=exactly-32-random-characters-here

# calagopus. The proxy network's subnet, so the panel attributes requests to
# the real client rather than to NPM's container IP -- without it rate
# limiting and the activity log see every visitor as one address. Check with:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
CALAGOPUS_TRUSTED_PROXIES=172.18.0.0/16

# ----------------------------------------------------------------------------
# VAULTWARDEN
# ----------------------------------------------------------------------------

# Passed to the container as DOMAIN. Vaultwarden
# refuses WebAuthn/U2F if this does not match the browser's URL exactly,
# scheme included.
VAULTWARDEN_DOMAIN=https://vaultwarden.example.com
# Keep signups off; flip to true only while onboarding your own accounts.
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true
VAULTWARDEN_WEBSOCKET_ENABLED=true

# ----------------------------------------------------------------------------
# COUCHDB
# ----------------------------------------------------------------------------
COUCHDB_USER=admin

# couchdb. Admin credentials; also what any Obsidian
# LiveSync client authenticates with.
COUCHDB_PASSWORD=generate-a-long-random-string

# ----------------------------------------------------------------------------
# STIRLING-PDF
# ----------------------------------------------------------------------------
STIRLING_ENABLE_SECURITY=false
STIRLING_ENABLE_LOGIN=false

# Pulls in Calibre at start; adds ~1GB and a
# noticeably slower first boot.
STIRLING_INSTALL_BOOK_OPS=true

# ----------------------------------------------------------------------------
# MONITORING / DASHBOARD
# ----------------------------------------------------------------------------
BESZEL_KEY=paste-from-beszel-hub-add-system

# beszel-agent. Pairs the agent with the hub; the hub will
# not accept a mismatched pair.
BESZEL_TOKEN=paste-from-beszel-hub-add-system

# glance, for the releases widgets. Only needs public_repo;
# without it those widgets hit the unauthenticated 60/hour rate limit.
GITHUB_TOKEN=ghp_replace_me

# ----------------------------------------------------------------------------
# AI  (claw.example.com)
# ----------------------------------------------------------------------------

# openclaw. Authenticates every call to the gateway, including the Control
# UI. The container starts happily with this empty, which is the failure to
# watch for: an unset token means an unauthenticated gateway rather than a
# refusal to boot.
OPENCLAW_GATEWAY_TOKEN=replace-with-output-of-openssl-rand-hex-32

# ----------------------------------------------------------------------------
# HOST-SIDE TOOLING  (not read by compose)
#
# Nothing below is interpolated into any compose file, so leaving these unset
# breaks no container. They are read by the scripts in this repo, or used by
# hand during setup. They live here so a rebuild does not have to rediscover
# what the tooling expects.
# ----------------------------------------------------------------------------

# collections/coverage.py, for the weekly Auto Collections gap report. The
# script reads them from the environment, falling back to parsing this file.
# Through the reverse proxy, so the host-side cron can reach it (the host
# cannot reach the macvlan IP directly).
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=create-in-jellyfin-dashboard-api-keys

# uptime-kuma, for scripted monitor management. Kuma exposes no REST API for
# creating monitors, so tooling logs in over socket.io with these.
KUMA_USER=admin
KUMA_PASS=change-me

# The NAS CIFS share behind /mnt/media. The live mount reads
# /root/.smbcred, not this file -- these are kept for reference when
# rebuilding that credentials file or mounting the share by hand.
NAS_USER=change-me
NAS_PASS=change-me

# gitea bootstrap admin. Registration is disabled and INSTALL_LOCK is on,
# so the first account is created with `gitea admin user create` inside the
# container; these are what it was created with.
GITEA_ADMIN_USER=change-me
GITEA_ADMIN_PASSWORD=change-me
